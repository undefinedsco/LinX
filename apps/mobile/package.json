{
  "name": "@linx/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:web": "yarn --cwd ../web build",
    "sync": "yarn run build:web && node ./scripts/capacitor-sync.mjs",
    "build": "yarn run sync",
    "smoke": "yarn run build",
    "build:android:debug": "node ./scripts/build-android-debug.mjs",
    "doctor": "capacitor doctor",
    "add:android": "capacitor add android",
    "add:ios": "capacitor add ios",
    "open:android": "capacitor open android",
    "open:ios": "capacitor open ios",
    "run:android": "yarn run build:web && capacitor run android",
    "run:ios": "yarn run build:web && capacitor run ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "typescript": "^5.4.0"
  }
}
