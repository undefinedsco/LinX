{
  "name": "@linx/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./acp": {
      "types": "./src/acp.ts",
      "node": "./dist/acp.js",
      "default": "./src/acp.ts"
    },
    "./auto-mode": {
      "types": "./src/auto-mode.ts",
      "node": "./dist/auto-mode.js",
      "default": "./src/auto-mode.ts"
    },
    "./companion-model": {
      "types": "./src/companion-model.ts",
      "node": "./dist/companion-model.js",
      "default": "./src/companion-model.ts"
    },
    "./control-plane": {
      "types": "./src/control-plane.ts",
      "node": "./dist/control-plane.js",
      "default": "./src/control-plane.ts"
    },
    "./file-sync": {
      "types": "./src/file-sync.ts",
      "node": "./dist/file-sync.js",
      "default": "./src/file-sync.ts"
    },
    "./reconciler": {
      "types": "./src/reconciler.ts",
      "node": "./dist/reconciler.js",
      "default": "./src/reconciler.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "node": "./dist/runtime.js",
      "default": "./src/runtime.ts"
    },
    "./symphony": {
      "types": "./src/symphony.ts",
      "node": "./dist/symphony.js",
      "default": "./src/symphony.ts"
    },
    "./sync": {
      "types": "./src/sync.ts",
      "node": "./dist/sync.js",
      "default": "./src/sync.ts"
    },
    "./thread-reconciler-controller": {
      "types": "./src/thread-reconciler-controller.ts",
      "node": "./dist/thread-reconciler-controller.js",
      "default": "./src/thread-reconciler-controller.ts"
    },
    "./turn-controller": {
      "types": "./src/turn-controller.ts",
      "node": "./dist/turn-controller.js",
      "default": "./src/turn-controller.ts"
    },
    "./wake-scheduler": {
      "types": "./src/wake-scheduler.ts",
      "node": "./dist/wake-scheduler.js",
      "default": "./src/wake-scheduler.ts"
    },
    "./workspace": {
      "types": "./src/workspace.ts",
      "node": "./dist/workspace.js",
      "default": "./src/workspace.ts"
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "test": "yarn build && node --test test/*.test.mjs && node --import tsx --test test/*.test.ts",
    "lint": "echo \"lint not configured\""
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
