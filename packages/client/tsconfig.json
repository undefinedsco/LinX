{
  "extends": "../../tsconfig.json",
  "include": [
    "src/index.ts",
    "src/client/index.ts",
    "src/watch/index.ts"
  ],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "declaration": true,
    "composite": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  }
}
