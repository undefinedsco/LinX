{
  "name": "@linx/e2e",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:local-onboarding": "playwright test specs/local-onboarding.spec.ts --workers=1",
    "test:real-auth": "playwright test specs/real-seeded-auth.spec.ts --workers=1",
    "test:real-cloud": "playwright test specs/real-cloud-auth.spec.ts --workers=1",
    "test:chat": "LINX_E2E_USE_SYSTEM_CHROME=1 LINX_E2E_PORT=5175 playwright test specs/chat-full-flow.spec.ts specs/message-formats.spec.ts --workers=1",
    "test:chat-full-flow": "LINX_E2E_USE_SYSTEM_CHROME=1 LINX_E2E_PORT=5175 playwright test specs/chat-full-flow.spec.ts --workers=1",
    "test:message-formats": "LINX_E2E_USE_SYSTEM_CHROME=1 LINX_E2E_PORT=5174 playwright test specs/message-formats.spec.ts --workers=1",
    "test:model-services": "LINX_E2E_USE_SYSTEM_CHROME=1 playwright test specs/real-seeded-auth.spec.ts --workers=1",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "dotenv": "^17.4.2"
  }
}
