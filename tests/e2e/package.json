{
  "name": "@linx/e2e",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:local-onboarding": "playwright test specs/local-onboarding.spec.ts --workers=1",
    "test:real-auth": "playwright test specs/real-seeded-auth.spec.ts --workers=1",
    "test:real-cloud": "playwright test specs/real-cloud-auth.spec.ts --workers=1",
    "test:files": "LINX_E2E_BASE_URL=http://127.0.0.1:5874 LINX_E2E_REUSE_SERVER=0 playwright test specs/files-real-pod-smoke.spec.ts --workers=1",
    "test:chat": "playwright test specs/chat-e2e.spec.ts",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "dotenv": "^17.4.2"
  }
}
