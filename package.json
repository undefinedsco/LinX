{
  "name": "linx-monorepo",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/agent-runtime",
    "packages/shared-ui",
    "packages/stores",
    "tests/*",
    "examples/*"
  ],
  "scripts": {
    "postinstall": "patch-package && node scripts/normalize-drizzle-solid-install.mjs",
    "dev:cli": "yarn workspace @undefineds.co/linx dev",
    "dev:web": "yarn workspace @linx/web dev",
    "dev:desktop": "yarn workspace @linx/desktop dev",
    "dev:service": "yarn workspace @linx/service dev",
    "dev:all": "yarn dev:web & yarn dev:desktop",
    "build:cli": "yarn workspace @undefineds.co/linx build",
    "models:update": "node scripts/models-workspace.mjs update",
    "models:status": "node scripts/models-workspace.mjs status",
    "models:assert-release-safe": "node scripts/models-workspace.mjs assert-release-safe",
    "build:agent-runtime": "yarn workspace @linx/agent-runtime build",
    "build:stores": "yarn workspace @linx/stores build",
    "pack:cli:preview": "yarn build:agent-runtime && yarn build:cli && node apps/cli/scripts/pack-preview-selfcontained.mjs",
    "pack:cli:selfcontained": "yarn build:agent-runtime && yarn build:cli && node apps/cli/scripts/pack-preview-selfcontained.mjs --release",
    "pack:cli:release": "yarn models:assert-release-safe && yarn build:agent-runtime && yarn build:cli && node apps/cli/scripts/pack-release.mjs",
    "build:web": "yarn workspace @linx/web build",
    "build:phase1": "yarn build:web && yarn build:desktop",
    "build:desktop": "yarn workspace @linx/desktop build",
    "build:service": "yarn workspace @linx/service build",
    "start:service": "yarn workspace @linx/service start",
    "preview:web": "yarn workspace @linx/web preview",
    "lint:web": "yarn workspace @linx/web lint",
    "typecheck:web": "yarn workspace @linx/web tsc --noEmit",
    "test:cli": "yarn workspace @undefineds.co/linx test",
    "test:cli:live-acp": "yarn workspace @undefineds.co/linx test:live-acp",
    "dev:example": "yarn workspace solid-login-example dev",
    "build:models": "node scripts/models-workspace.mjs build",
    "build": "yarn build:models && yarn build:agent-runtime && yarn build:web",
    "clean": "yarn workspace @linx/web clean && node scripts/models-workspace.mjs clean",
    "install:all": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 yarn install",
    "dev": "yarn dev:web",
    "lint": "yarn lint:web",
    "typecheck": "yarn typecheck:web",
    "test:unit": "yarn workspace @linx/web test --run && yarn test:cli",
    "test:integration:web": "yarn workspace @linx/web test:integration --run",
    "test:integration:web:perf": "yarn workspace @linx/web test:integration:perf --run",
    "verify:symphony-skills": "node scripts/verify-symphony-skills.mjs",
    "verify:symphony-dual-role": "node scripts/pack-symphony-dual-role-fixtures.mjs --check",
    "pack:symphony-dual-role": "node scripts/pack-symphony-dual-role-fixtures.mjs",
    "test:e2e": "yarn workspace @linx/e2e test",
    "test:e2e:ui": "yarn workspace @linx/e2e test:ui",
    "test": "yarn test:unit && yarn test:e2e"
  },
  "dependencies": {
    "@inrupt/solid-client": "^3.0.0",
    "@inrupt/solid-client-authn-browser": "^4.0.0",
    "@inrupt/vocab-common-rdf": "^1.0.5",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@undefineds.co/drizzle-solid": "0.3.20",
    "@undefineds.co/xpod": "0.3.52",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.15",
    "postinstall-postinstall": "^2.1.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.0.14"
  },
  "resolutions": {
    "**/drizzle-orm": "^0.45.2",
    "**/@undefineds.co/drizzle-solid": "0.3.20",
    "**/@undefineds.co/models": "0.2.45",
    "**/@tiptap/core": "3.27.1",
    "**/@tiptap/extensions": "3.27.1",
    "**/@tiptap/pm": "3.27.1",
    "**/@tiptap/react": "3.27.1",
    "**/@tiptap/starter-kit": "3.27.1",
    "**/react": "19.2.6",
    "**/react-dom": "19.2.6",
    "**/@inrupt/solid-client": "^3.0.0",
    "**/@inrupt/solid-client-authn-browser": "^4.0.0"
  }
}
